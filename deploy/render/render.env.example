# Environment template for SamoTech-style Telegram Webhook on Render.
# Enter real secret values only in Render Dashboard > Environment.
# Never commit a populated copy of this file.

# Telegram Bot API
TELEGRAM_BOT_TOKEN=replace-with-botfather-token
TELEGRAM_ALLOWED_CHAT_IDS=replace-with-comma-separated-chat-ids
TELEGRAM_WEBHOOK_SECRET_TOKEN=replace-with-long-random-webhook-secret

# RouterOS v6 API
MIKROTIK_ADDRESS=192.168.1.100
MIKROTIK_USER=telegram-monitor
MIKROTIK_PASSWORD=replace-with-routeros-api-password
MIKROTIK_PORT=8728
MIKROTIK_USE_SSL=false

# Internet monitoring and daily usage
MONITOR_TARGET=1.1.1.1
MONITOR_INTERVAL_SECONDS=30
TRAFFIC_INTERFACE=ether1
TRAFFIC_INTERVAL_SECONDS=60
TRAFFIC_STATE_FILE=/tmp/traffic_state.json
TRAFFIC_DAILY_REPORT_TIME=23:59

# These are used by the local long-polling service, not by Render Webhook.
# Keep them here so the same environment contract can be reused locally.
TELEGRAM_POLL_SECONDS=20
TELEGRAM_OFFSET_FILE=/tmp/.telegram_offset

# Render supplies PORT automatically. Keep this only for local Flask execution.
# PORT=10000

# Webhook URL to register after the service is live:
# https://<your-render-service>.onrender.com/telegram/webhook
