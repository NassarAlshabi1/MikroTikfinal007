[Unit]
Description=MikroTik RouterOS v6 Telegram Bot (Direct API)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=mikrotik-telegram
Group=mikrotik-telegram
WorkingDirectory=/opt/mikrotik-telegram
EnvironmentFile=/etc/mikrotik-telegram/bot.env
ExecStart=/opt/mikrotik-telegram/.venv/bin/python -m telegram_bot
Restart=always
RestartSec=10
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/mikrotik-telegram

[Install]
WantedBy=multi-user.target
