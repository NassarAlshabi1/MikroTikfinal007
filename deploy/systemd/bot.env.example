# Local deployment example. Never commit real values.
TELEGRAM_BOT_TOKEN=replace-with-a-new-token-from-botfather
TELEGRAM_ALLOWED_CHAT_IDS=5944227208
TELEGRAM_ALLOWED_USER_IDS=replace-with-telegram-user-id
TELEGRAM_ADMIN_USER_IDS=

MIKROTIK_ADDRESS=10.0.0.2
MIKROTIK_USER=telegram-monitor
MIKROTIK_PASSWORD=replace-with-routeros-password
MIKROTIK_PORT=8729
MIKROTIK_USE_SSL=true
# Optional CA file for a private/self-signed RouterOS certificate.
MIKROTIK_CA_FILE=
USER_MANAGER_CUSTOMER=admin

TELEGRAM_POLL_SECONDS=20
TELEGRAM_OFFSET_FILE=/var/lib/mikrotik-telegram/.telegram_offset
TELEGRAM_AUDIT_FILE=/var/lib/mikrotik-telegram/audit.jsonl
MONITOR_TARGET=1.1.1.1
MONITOR_INTERVAL_SECONDS=30
TRAFFIC_INTERFACE=ether1
TRAFFIC_INTERVAL_SECONDS=60
TRAFFIC_STATE_FILE=/var/lib/mikrotik-telegram/traffic-state.json
TRAFFIC_DAILY_REPORT_TIME=23:59
REBOOT_RECOVERY_ATTEMPTS=12
REBOOT_RECOVERY_INTERVAL_SECONDS=5
