# ============================================================
#  ملف إعدادات AI — انسخه إلى .env واملأ القيم
#  ملاحظة: لا ترفع ملف .env إلى git (موجود في .gitignore)
# ============================================================

# مزود الـ AI: openAI أو gemini
AI_PROVIDER=openAI

# الموديل (يختلف حسب المزود)
# OpenAI: gpt-4o-mini, gpt-4o, gpt-4-turbo
# Gemini: gemini-1.5-flash, gemini-1.5-pro
AI_MODEL=gpt-4o-mini

# مفتاح API (احصل عليه من:)
# OpenAI: https://platform.openai.com/api-keys
# Gemini: https://aistudio.google.com/app/apikey
AI_API_KEY=your-api-key-here

# طريقة الاتصال بـ MikroTik: routerOS أو ssh
MIKROTIK_METHOD=routerOS

# الحد الأقصى لـ tokens في الرد
AI_MAX_TOKENS=1500

# ============================================================
# Telegram bridge — لا تضع القيم الحقيقية في Git
# شغّل telegram_bridge/telegram_bridge.py كخدمة مستقلة
# ============================================================
TELEGRAM_BOT_TOKEN=replace-with-a-new-token-from-botfather
TELEGRAM_ALLOWED_CHAT_IDS=replace-with-your-chat-id
TELEGRAM_POLL_SECONDS=20
TELEGRAM_OFFSET_FILE=.telegram_offset

# بيانات RouterOS v6 للخدمة الوسيطة
MIKROTIK_ADDRESS=192.168.88.1
MIKROTIK_USER=api-user
MIKROTIK_PASSWORD=replace-with-router-password
MIKROTIK_PORT=8728
MIKROTIK_USE_SSL=false
